{
  "manifest_version": 3,
  "name": "IO HELPER",
  "version": "2.12.0",
  "description": "Улучшает функционал IO сайта",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "icons": {
    "128": "icons/logo_small_default.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/logo_small_monochrome.png"
  },
  "host_permissions": [
    "https://io.cybershoke.net/*",
    "https://io.cybershoke.ru/*",
    "https://raw.githubusercontent.com/K4NT1K/*",
    "https://mobile.fastmm.win/*",
    "https://translate.googleapis.com/*",
    "https://api.mymemory.translated.net/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icons.json",
        "dist/chunks/*"
      ],
      "matches": [
        "*://*.cybershoke.net/*",
        "*://*.cybershoke.ru/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://io.cybershoke.net/*", "https://io.cybershoke.ru/*"],
      "js": ["dist/siteBridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.cybershoke.net/*",
        "*://*.cybershoke.ru/*"
      ],
      "css": [
        "css/panel.css",
        "css/analysis.css",
        "css/tooltip.css",
        "css/highlight.css",
        "css/misc.css",
        "css/ticketCards.css",
        "css/liquidGlass.css",
        "css/profileLauncher.css"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
