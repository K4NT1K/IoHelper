`,au=p.button`
    position: absolute;
    right: -26px;
    top: 36px;
    width: 24px;
    height: 24px;
    border-radius: 8px;
    background: #171b26;
    color: rgb(87, 99, 144);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    flex-shrink: 0;
    z-index: 1;
    transition: all 0.2s ease;

    svg {
        content: '';
        width: 16px;
        height: 16px;
        transform: ${e=>e.$collapsed?"rotate(180deg)":"rotate(0deg)"};
        transition:
            color 0.18s ease,
            transform 0.18s ease;
    }

    &:hover {
        background: #1a2133;
        transform: scale(1.04);
    }

    @media all and (max-width: 1000px) {
        display: none;
    }
`,nj=p.aside`
    width: ${e=>e.$collapsed?"84px":"246px"};
    min-width: ${e=>e.$collapsed?"84px":"246px"};
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
    padding: ${e=>e.$collapsed?"16px 12px 24px":"16px"};
    padding-bottom: 24px;
    padding-top: ${e=>e.$collapsed?"18px":"14px"};
    background: #0c101a;
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    transition: all 0.2s ease;
    z-index: ${qE};

    & > div {
        width: 100%;
    }

    &.collapsed {
        .sidebar-top {
            padding: 0 6px;
            flex-direction: column;
        }

        .sidebar-link {
            gap: 0;
            padding: 10px 18px;

            span {
                max-width: 0;
                opacity: 0;
                pointer-events: none;
            }

            .sidebar-progress-badge {
                max-width: 0;
                margin-left: 0;
                padding: 0;
                opacity: 0;
            }
        }

        ${ou} svg {
            height: 40px;
        }

        .sidebar-separator {
            margin: 8px auto;
        }
    }

    &:hover {
        ${au} {
            opacity: 1;
        }
    }

    @media all and (max-width: 1000px) {
        width: 100%;
        height: auto;
        min-width: 0;
        top: auto;
        flex-direction: row;
        gap: 0;
        padding: 0;
        background: rgba(19, 24, 33, 0.9);
        backdrop-filter: blur(8px);

        .sidebar-top,
        .sidebar-bottom,
        .sidebar-separator {
            display: none;
        }

        .sidebar-nav {
            flex-direction: row;
            justify-content: center;
            gap: 4px;
            margin-top: 0 !important;
            padding: 14px 16px;
        }

        .sidebar-link {
            width: 100%;
            min-width: 0;
            flex: 1 1 0;
            justify-content: center;
            padding: 8px;

            &.desktop-only {
                display: none;
            }

            span {
                display: none;
            }

            .sidebar-progress-badge {
                display: none;
            }
        }

        .sidebar-miniapps {
            flex: 1 1 0;
            min-width: 0;
        }

        .sidebar-hover-highlight {
            display: none;
        }
    }
