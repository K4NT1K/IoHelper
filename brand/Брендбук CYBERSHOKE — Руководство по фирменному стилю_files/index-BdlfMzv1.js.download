    }

    @keyframes keyboard-search-shake {
        0%,
        100% {
            transform: translate(-50%, -50%);
        }

        25% {
            transform: translate(calc(-50% - 7px), -50%);
        }

        75% {
            transform: translate(calc(-50% + 7px), -50%);
