    letter-spacing: 1px;
    text-overflow: ellipsis;
    white-space: nowrap;
    top: 16px;
    left: 24px;
    text-transform: none;
    color: #fff;
    font-family: var(--font-family-0);
    font-weight: 700;
    position: absolute;
    z-index: 20;
    font-size: 18px;
    display: flex;
    align-items: center;
`,vc=p.div`
    position: relative;
    transition: 0.3s;
    border-radius: 12px;
    height: 80px;
    vertical-align: top;
    overflow: hidden;
    z-index: 1;

    &::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 5;
        background: linear-gradient(
            180deg,
            rgba(44, 61, 104, 0.5) 0%,
            rgba(65, 84, 152, 0.5) 100%
        );
        opacity: ${({$hasFriend:e})=>e?1:0};
        pointer-events: none;
    }

    &::after {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 100;
        border-radius: inherit;
        box-shadow: inset 0 0 0 1px rgba(96, 128, 255, 0.4);
        opacity: ${({$hasFriend:e})=>e?1:0};
        pointer-events: none;
    }

    &:hover {
        cursor: pointer;
        opacity: 1 !important;

        div img {
            opacity: 1 !important;
            transition: 0.5s;
        }
    }

    &.closed-server {
        background: linear-gradient(
            0deg,
            rgba(0, 23, 54, 0.35),
            rgba(0, 23, 54, 0.35)
        );

        &:hover div img {
            opacity: 0.35 !important;
        }
    }

    &.closed-server-prime .block-border-map {
        background: linear-gradient(
            0deg,
            rgba(0, 23, 54, 0.35),
            rgba(0, 23, 54, 0.35)
        );
        z-index: 6;
    }

    .block-border-prime {
        content: '';
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(60deg, #6ed2fe, #46a5fe, #5496fe);
        background-size: 300% 300%;
        background-position: 0 50%;
        border-radius: 12px !important;
    }

    .block-border-locked {
        content: '';
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: 2px solid #91a8b9;
        background-size: 300% 300%;
        background-position: 0 50%;
        border-radius: 12px !important;
        z-index: 1;
    }

    .block-servers-map-img {
        height: 100% !important;
        width: 100% !important;
        position: relative !important;

        img {
            object-fit: cover !important;
            height: 100% !important;
            width: 100% !important;
            opacity: 0.3;
            transition: 0.5s;
            border-radius: 12px;
        }
    }

    .block-servers-name {
        display: inline-flex;
        align-items: center;
        pointer-events: none;
        cursor: pointer !important;

        &:hover {
            transform: unset !important;
        }
    }

    .group {
        transition: 0.3s;
        font-style: normal;
        position: absolute;
        bottom: 18px;
        left: 24px;
        letter-spacing: 0;
        color: rgba(255, 255, 255, 0.5);
        font-weight: normal;
        font-size: 12px;
        z-index: 20;
        display: flex;
        align-items: center;

        &:hover {
            color: white;
        }
    }

    .block-servers-group-info {
        display: inline-block;
        color: rgba(255, 255, 255, 0.5);
        font-weight: 500;
        font-size: 12px;
    }

    a {
        border-radius: 12px 0;
        background: rgba(0, 0, 0, 0.1);
        color: #aecce4;
        display: flex;
        transition: 0.3s;
        z-index: 25;
        text-align: center;
        justify-items: center;
        height: 40px;
        align-items: center;
        width: 40px;
        position: absolute;
        bottom: 0;
        opacity: 1;
        right: 0;
        justify-content: center;
        text-decoration: none;

        &:hover {
            background: rgba(255, 255, 255, 0.2);
        }

        img {
            vertical-align: middle;
            height: 16px;
        }

        svg {
            vertical-align: middle;
            color: #AECCE4;
        }

        &.closed-indicator {
            height: 80px !important;
            background: transparent !important;

            &:hover {
                background: transparent !important;
            }
        }

        &.copy-ip {
            bottom: auto !important;
            top: 0 !important;
            background: rgba(0, 0, 0, 0.1) !important;
            color: #aecce4 !important;
            border-radius: 0 12px !important;

            &:hover {
                background: rgba(255, 255, 255, 0.2) !important;
                color: white !important;
            }
        }
    }

    .alt {
        position: absolute;
        display: none;
        white-space: nowrap;
        opacity: 0;
    }

    .alt-left {
        display: none;
        right: 120%;
        opacity: 1;
        border-radius: 4px;
        padding: 0 8px;
        font-size: 12px;
        background-color: #1c2130;
        transition-property: visibility, opacity, transform;
        outline: 0;
        height: 28px;
        font-family: 'Roboto';
        color: #8f96ac;
        align-items: center;
        justify-content: center;
        transition: 0.3s;
    }

    .tip:hover .alt,
    .tip:hover .alt-left {
        display: inline-flex;
        opacity: 1;
    }
`,wc=p.span`
    margin-left: 6px;
    padding: 1px 6px;
    border-radius: 3px;
    background: rgba(0, 0, 0, 0.3);
    color: rgba(255, 255, 255, 0.5);
    font-size: 12px;
    font-weight: 700;
    line-height: 16px;
    white-space: nowrap;

    &.success {
        color: #85f479;
        background: rgba(133, 244, 121, 0.25);
    }

    &.warning {
        color: #fdb510;
        background: rgba(253, 181, 16, 0.15);
    }
