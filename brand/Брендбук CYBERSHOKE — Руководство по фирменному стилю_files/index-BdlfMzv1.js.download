    border-radius: 8px;
    border: 2px solid rgba(255, 255, 255, 0.05);
    display: flex;
    background: transparent !important;
    align-items: center;
    gap: 8px;
    color: #aecce4;

    .icon {
        transition: fill 0.2s ease;
    }

    &:hover .icon {
        fill: #6080ff;
    }
`,Iy=p.div`
    display: flex;
    align-items: center;
    justify-content: center;

    &::after {
        content: '';
        width: 1px;
        height: 14px;
        border-radius: 8px;
        background: #1c2027;
    }
`,Ny=p.nav`
    font-size: 0;
    text-align: center;
    display: flex;
    top: 0;
    right: 0;
    z-index: 9;
    background-color: transparent !important;
    padding: 0;
    margin: 0 1vw;
    justify-content: center;
    gap: 4px;
    row-gap: 6px;
    flex-wrap: wrap;
    white-space: normal;

    a {
        background-color: rgba(255, 255, 255, 0.05);
        transition: 0.3s;
        border-radius: 8px;
        height: 40px;
        font-family: var(--font-family-0);
        font-size: 12px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 0 16px;

        &:last-of-type {
            margin-right: 0;
        }

        &:hover {
            background: rgba(255, 255, 255, 0.1);
            color: #6080ff;
        }
    }

    .nav-servers-button {
        position: relative;

        &.liked {
            background:
                radial-gradient(
                    176.03% 141.42% at 100% 0%,
                    rgba(85, 115, 230, 0.25) 0%,
                    rgba(85, 115, 230, 0.22) 4.35%,
                    rgba(85, 115, 230, 0.2) 8.7%,
                    rgba(85, 115, 230, 0.17) 13.04%,
                    rgba(85, 115, 230, 0.15) 17.39%,
                    rgba(85, 115, 230, 0.14) 21.74%,
                    rgba(85, 115, 230, 0.12) 26.09%,
                    rgba(85, 115, 230, 0.1) 30.43%,
                    rgba(85, 115, 230, 0.09) 34.78%,
                    rgba(85, 115, 230, 0.07) 39.13%,
                    rgba(85, 115, 230, 0.07) 43.48%,
                    rgba(85, 115, 230, 0.05) 47.83%,
                    rgba(85, 115, 230, 0.04) 52.17%,
                    rgba(85, 115, 230, 0.03) 56.52%,
                    rgba(85, 115, 230, 0.03) 60.87%,
                    rgba(85, 115, 230, 0.02) 65.22%,
                    rgba(85, 115, 230, 0.01) 69.57%,
                    rgba(85, 115, 230, 0.01) 73.91%,
                    rgba(85, 115, 230, 0.01) 78.26%,
                    rgba(85, 115, 230, 0) 82.61%,
                    rgba(85, 115, 230, 0) 86.96%,
                    rgba(85, 115, 230, 0) 91.3%,
                    rgba(85, 115, 230, 0) 95.65%,
                    rgba(85, 115, 230, 0) 100%
                ),
                #ffffff0d;
        }
    }

    span {
        color: white;
        transition: 0.3s;
        border-radius: 24px;
        border: 2px solid #8aa2b6;
        min-width: 24px;
        padding: 0 5px 0 6px;
        line-height: 19px;
        font-size: 10px;
        font-weight: bold;
        display: inline-block;
        margin-left: 6px;
        top: -1px;
        text-align: center;
    }
`,lc=p.a`
    padding: 0 12px !important;
    opacity: 0.7;
    display: flex;
    align-items: center;
    justify-content: center;

    &:hover,
    &.opened {
        opacity: 1;
    }

    img {
        transition: 0.3s;
        opacity: 0.4;
        width: 20px;
        height: 20px;
    }

    &:hover img,
    &.opened img {
        opacity: 1;
    }
`,Dy=p.div`
    position: absolute;
    top: -5px;
    right: -4px;
    width: 18px;
    height: 18px;
    opacity: 0;
    transition: opacity 0.2s ease;

    > div {
        position: absolute;
        inset: 0;
        opacity: 0;
        transition: opacity 0.2s ease;
    }

    svg {
        width: 18px;
        height: 18px;
        display: block;
    }

    .default {
        opacity: 1;
    }

    &:hover {
        .default {
            opacity: 0;
        }

        .hover {
            opacity: 1;
        }
    }

    .nav-servers-button.liked & {
        .default,
        .hover {
            opacity: 0;
        }

        .active {
            opacity: 1;
        }
    }

    .nav-servers-button.liked &:hover {
        .active {
            opacity: 0;
        }

        .active-hover {
            opacity: 1;
        }
    }

    .nav-servers-button:hover &,
    .nav-servers-button.liked & {
        opacity: 1;
    }
`,Cp=p.div`
    transition: transform 0.2s ease;
    color: #aecce4;
`,By=p.div`
    width: 100%;
    text-align: left;
    color: #aecce4;
    font-size: 11px;
    font-family: 'Roboto Condensed', sans-serif;
    font-weight: 400;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: all 0.3s ease;
    flex-shrink: 0;
    max-height: 0;
    opacity: 0;

    .nav-servers-button:hover & {
        max-height: 20px;
        opacity: 0.5;
    }
