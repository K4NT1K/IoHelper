`,yd=p.div`
    display: grid;
    gap: 2px;
`,vd=p.div`
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 34px;
    padding: 0 8px;
    margin: 0 -8px;
    border-radius: 8px;
    cursor: pointer;

    &:hover {
        background: rgba(255, 255, 255, 0.05);
    }

    strong {
        color: #f5f7ff;
        font-size: 13px;
        font-weight: 600;
    }

    strong em {
        margin-left: 6px;
        color: #7a8697;
        font-size: 11px;
        font-style: normal;
        font-weight: 500;
        text-transform: uppercase;
    }

    button {
        display: flex;
        background: none;
        cursor: pointer;
    }

    select:disabled {
        opacity: 0.4;
        cursor: default;
    }

    select {
        height: 24px;
        padding: 0 4px;
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.08);
        color: #eef3ff;
        font-size: 12px;
        cursor: pointer;
    }

    option {
        background: #1b2030;
    }

    svg {
        flex: none;
        width: 18px;
        height: 18px;
    }
