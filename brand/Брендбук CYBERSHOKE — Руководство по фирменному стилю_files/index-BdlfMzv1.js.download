    --sc-bg: #141825;
    --sc-surface: #171c2a;
    --sc-raised: #1d2335;
    --sc-hover: #232a3f;
    --sc-body: #d5d9f3;
    --sc-muted: #7a8697;
    --sc-faint: rgba(122, 134, 151, 0.6);
    --sc-line: rgba(255, 255, 255, 0.07);
    --sc-line-strong: rgba(255, 255, 255, 0.12);
    --sc-accent: #6080ff;
    --sc-accent-hover: #4a6dff;
    --sc-accent-soft: rgba(96, 128, 255, 0.14);
    --sc-success: #3ecf8e;
    --sc-warning: #ffa800;
    --sc-warning-soft: rgba(255, 168, 0, 0.14);
    --sc-danger: #f64e60;
    --sc-danger-soft: rgba(246, 78, 96, 0.14);
    --sc-ease: cubic-bezier(0.16, 1, 0.3, 1);
`,ks=e=>e==="online"?"var(--sc-success)":e==="warning"?"var(--sc-warning)":e==="danger"?"var(--sc-danger)":"var(--sc-faint)",_7=p.button`
    ${sp}

    position: fixed;
    right: ${es}px;
    bottom: ${es}px;
    z-index: 1201;
    width: ${ia}px;
    height: ${ia}px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 999px;
    background: var(--sc-accent);
    color: #fff;
    box-shadow:
        0 2px 6px rgba(6, 8, 14, 0.45),
        0 12px 32px rgba(6, 8, 14, 0.4);
    cursor: pointer;
    transition:
        transform 0.16s var(--sc-ease),
        background-color 0.16s ease,
        opacity 0.24s var(--sc-ease);

    /* иконка чата смещена вниз-влево, чтобы стоять в оптическом центре */
    svg {
        transform: translate(-1px, 1px);
    }

    &:hover {
        background: var(--sc-accent-hover);
        transform: translateY(-2px);
    }

    &:active {
        transform: scale(0.96);
    }

    &:focus-visible {
        outline: none;
        box-shadow:
            0 0 0 3px var(--sc-bg),
            0 0 0 5px var(--sc-accent);
    }

    ${ip} {
        right: 16px;
        bottom: 16px;
    }

    ${({$hidden:e})=>e&&je`
            opacity: 0;
            transform: scale(0.8);
            pointer-events: none;
        `}
`,E7=p.span`
    position: absolute;
    top: -4px;
    right: -4px;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--sc-danger);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    line-height: 22px;
    text-align: center;
    font-variant-numeric: tabular-nums;
    box-shadow: 0 0 0 3px var(--sc-bg);
`,$1="cubic-bezier(0.16, 1, 0.3, 1)",Q1="cubic-bezier(0.7, 0, 0.84, 0)",j7=p.section`
    ${sp}

    position: fixed;
    right: ${es}px;
    bottom: ${es+ia+12}px;
    z-index: 1201;
    width: 400px;
    /* высота из макета, но не выше 60% экрана: на низком окне панель давит на сайт */
    height: min(616px, 60vh);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--sc-line);
    border-radius: 20px;
    /* панель - сама по себе материал: сайт под ней просвечивает и размыт */
    background: rgba(20, 24, 37, 1);
    box-shadow:
        0 1px 2px rgba(6, 8, 14, 0.5),
        0 24px 64px rgba(6, 8, 14, 0.55);
    color: var(--sc-body);
    font-family: 'Roboto', sans-serif;
    -webkit-font-smoothing: antialiased;
    /* точка происхождения - кнопка-лаунчер справа снизу */
    transform-origin: 100% 100%;

    /*
     * Переход, а не keyframes: анимация обязана стартовать с текущего
     * экранного значения. Если игрок жмет лаунчер посреди закрытия, окно
     * подхватывается с той прозрачности, на которой было, без скачка назад.
     */
    opacity: ${({$shown:e})=>e?1:0};
    transform: ${({$shown:e})=>e?"translateY(0) scale(1)":"translateY(12px) scale(0.98)"};
    transition:
        opacity 240ms ${$1},
        transform 240ms ${$1};
    will-change: transform, opacity;

    ${({$shown:e})=>!e&&je`
            transition:
                opacity 170ms ${Q1},
                transform 170ms ${Q1};
        `}

    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    ${ip} {
        inset: 0;
        width: auto;
        height: 100dvh;
        border: none;
        border-radius: 0;
        /* во весь экран - уезжает за тот же нижний край, из которого пришло */
        transform: ${({$shown:e})=>e?"translateY(0)":"translateY(100%)"};
        transform-origin: 50% 100%;
        /* поверх сайта на телефоне ничего не видно - стекло не нужно */
        background: var(--sc-bg);
        backdrop-filter: none;
    }
`,L7=p.div`
    position: relative;
    z-index: 2;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    padding: 20px 12px 18px 20px;
    background: rgba(23, 28, 42, 0.86);
    backdrop-filter: blur(20px) saturate(180%);

    /*
     * Арт стартового экрана собран слоями фона, а не картинкой в разметке:
     * затемнение слева держит текст читаемым, нижний градиент растворяет
     * шапку в панели - поэтому там же гаснет и тень под ней.
     */
    ${({$art:e})=>e&&je`
            height: 150px;
            justify-content: space-between;
            padding-bottom: 0;
            backdrop-filter: none;
            background-image:
                linear-gradient(
                    180deg,
                    rgba(20, 24, 37, 0) 0%,
                    rgba(20, 24, 37, 0.55) 55%,
                    var(--sc-bg) 100%
                ),
                linear-gradient(
                    90deg,
                    rgba(17, 21, 33, 0.9) 0%,
                    rgba(17, 21, 33, 0.55) 52%,
                    rgba(17, 21, 33, 0.2) 100%
                ),
                url(${e}),
                linear-gradient(100deg, #171d2b 0%, #1f2740 52%, #2b3767 100%);
            background-repeat: no-repeat;
            background-size:
                100% 90px,
                cover,
                cover,
                cover;
            background-position:
                bottom,
                center,
                58% 22%,
                center;

            &::after {
                display: none;
            }
        `}

    &::after {
        content: '';
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        height: 12px;
        background: linear-gradient(180deg, rgba(6, 8, 14, 0.22), transparent);
        pointer-events: none;
    }
`,T7=p.div`
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    min-height: 38px;
`,O7=p.p`
    /* держим приветствие в две строки: третья упирается в карточку под шапкой */
    max-width: 250px;
    margin: 20px 0 0;
    color: #fff;
    font-size: 21px;
    font-weight: 800;
    line-height: 28px;
    letter-spacing: -0.01em;
    text-wrap: balance;

    span {
        color: #8b96a8;
    }
`,R7=p.div`
    flex: 1 1 auto;
    min-width: 0;

    h2 {
        margin: 0;
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        line-height: 1.25;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        text-transform: none;
    }

    p {
        margin: 3px 0 0;
        display: flex;
        align-items: center;
        gap: 6px;
        color: var(--sc-muted);
        font-size: 12px;
        line-height: 1.3;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* тема разговора - не статус, поэтому и цвет у нее свой */
    p.topic {
        color: #9db4ff;
    }
`,bi=p.i`
