    --nf-panel-h: 266px;
    --nf-row-h: 42px;

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    overflow: hidden;
    background:
        radial-gradient(
            ellipse 72% 48% at 50% 52%,
            rgba(68, 94, 226, 0.15),
            transparent 72%
        ),
        linear-gradient(
            90deg,
            rgba(4, 7, 12, 0.34) 0%,
            transparent 14%,
            transparent 86%,
