    display: flex;
    align-items: center;
    justify-content: center;
    /* flex-direction: column; */
    /* padding: 6px 0 12px; */
    padding-right: 10px;
    gap: 6px;

    div {
        font-size: 13px;
        font-weight: 700;
    }

    span {
        margin: 0 !important;
    }

    .live-dot {
        height: 6px;
        width: 6px;
        border-radius: 100%;
        background-color: #6080ff;
        text-align: center;
        display: block;

        &::after {
            content: '';
            display: block;
            height: 100%;
            position: absolute;
            width: 100%;
            border-radius: 100%;
            background-color: inherit;
            animation: 3s ease-out signal infinite;
            opacity: 0.5;
        }
    }

    &.collapsed {
        padding: 0;
        /* flex-direction: column; */
    }

    @media (max-width: 768px) {
        flex-direction: row;
        padding: 0;
    }
