    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 10px;
    background: transparent;
    color: var(--sc-muted);
    cursor: pointer;
    transition:
        background-color 0.16s ease,
        color 0.16s ease;

    &:hover {
        background: var(--sc-hover);
        color: #fff;
    }

    &:active {
        background: var(--sc-hover);
        transform: scale(0.92);
    }

    &:focus-visible {
        outline: none;
        box-shadow: 0 0 0 2px var(--sc-accent);
    }

    &:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }
`,P7=p.div`
