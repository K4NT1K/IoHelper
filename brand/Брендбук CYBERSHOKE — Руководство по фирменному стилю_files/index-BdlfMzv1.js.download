    position: fixed;
    top: 50%;
    left: 50%;
    z-index: 30;
    transform: translate(-50%, -50%);
    pointer-events: none;
    color: #ffffff;
    font-family: var(--font-family-0);
    font-size: clamp(42px, 7vw, 96px);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-shadow: 0 10px 34px rgba(0, 0, 0, 0.75);
    opacity: 1;
    transition: opacity 0.25s ease;

    &.fade-out {
        opacity: 0;
    }

