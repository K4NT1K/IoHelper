    margin-top: 40px;
    width: 100%;
    flex-shrink: 0;

    .unauth & {
        height: 280px;
    }

    .flex-wrap {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        gap: 0;
        overflow: auto;
        padding-bottom: 40px;
    }

    .footer__sponsors {
        width: 100%;
        text-align: center;
        position: relative;
        padding-left: 60px;
        padding-right: 60px;
    }

    .footer__sponsors img {
        transition: 0.3s;
        opacity: 0.1;
        max-width: 170px;
        max-height: 80px;
        background: 0 0;
    }

    .footer__sponsors a {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
    }

    .footer__sponsors a:hover img {
        opacity: 1;
        transition: 0.3s;
        filter: grayscale(24%);
    }

    .footer__navigation {
        width: 100%;
        display: flex;
        flex-wrap: wrap;
        row-gap: 80px;
        justify-content: space-between;
        padding: 48px 96px 80px 96px;
        border-top: 1px solid #1c2127;
    }

    .simplified-footer {
        padding: 48px 0 80px 0;
    }

    .footer__logo {
        display: flex;
        padding-right: 10px;
        gap: 30px;
    }

    .footer__logo img {
        height: 30px;
        margin-top: 3px;
    }

    .footer-company {
        width: 230px;
    }

    .footer-notaffiliated {
        padding: 12px 6px;
        color: #515766ad;
        font-size: 12px;
        font-weight: 400;
        line-height: 16px;
        width: 100%;
        text-align: center;
        display: block;
        position: absolute;
        bottom: 0;
        left: 0;
    }

    .footer-company h5 {
        color: #727783;
        font-size: 14px;
        font-weight: 500;
        line-height: 18px;
        margin-bottom: 16px;
    }

    .footer-company h6,
    .footer-company span {
        color: #515766;
        font-size: 12px;
        font-weight: 400;
        line-height: 18px;
        text-transform: uppercase;
    }

    .footer-company span {
        text-transform: none;
    }

    .footer-company h6 {
        font-weight: 600;
    }

    .footer-right {
        display: flex;
        gap: 106px;
        flex-wrap: wrap;
    }

    .footer__nav-list {
        display: flex;
        gap: 86px;
        flex-wrap: wrap;
    }

    .footer__nav-list ul {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .footer__nav-list li {
        display: inline;
        list-style-type: none;
        color: #9a9fa9;
        transition: filter 0.2s ease;
        font-size: 14px;
        font-weight: 400;
    }

    .footer__nav-list li:hover {
        filter: brightness(125%);
    }

    .footer-socials-wrapper {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 20px;
    }

    .footer__socials {
        display: flex;
        gap: 12px;
    }

    .footer__socials img {
        width: 100%;
        transition: filter 0.2s ease;
    }

    .footer__socials a {
        display: flex;
        width: 22px;
        height: 22px;
        align-items: center;
    }

    .footer__socials a:hover img {
        filter: brightness(135%);
    }

    .footer-payments {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .footer-payments svg {
        height: 16px;
        filter: brightness(50%);
        transition: filter 0.2s ease;
    }

    .footer-payments svg:hover {
        filter: brightness(100%);
    }

    .footer-lang {
        padding: 12px;
        border-radius: 6px;
        background: #141926;
        gap: 12px;
        display: flex;
        align-items: center;
    }

    .footer-lang__wrapper {
        position: relative;
        z-index: 200;
    }

    .footer-lang svg {
        transition: transform 0.2s ease;
    }

    .footer-lang.active svg {
        transform: rotate(180deg);
    }

    .footer-lang__current {
        color: #b5c3db;
        font-size: 14px;
        font-weight: 400;
        gap: 8px;
        display: flex;
        align-items: center;
    }

    .footer-lang__current img {
        width: 18px;
    }

    @media all and (max-width: 1750px) {
        .footer__sponsors img {
            width: 130px;
        }
    }

    @media all and (max-width: 1450px) {
        .footer__sponsors img {
            width: 130px;
        }
    }

    @media all and (max-width: 1366px) {
        .footer-right {
            row-gap: 50px;
        }
    }

    @media all and (max-width: 1000px) {
        .footer-socials-wrapper {
            align-items: flex-start;
            gap: 30px;
        }
    }

    @media all and (max-width: 750px) {
        .footer__navigation,
        .footer__sponsors {
            padding-left: 20px;
            padding-right: 20px;
        }
    }

    @media all and (max-width: 740px) {
        .footer__sponsors::after {
            content: '';
            position: absolute;
            bottom: 0;
            width: 40px;
            opacity: 0.4;
            height: 40px;
            background: url(${P("/img/icons/swipe-horizontal.png")})
                no-repeat center center / cover;
            right: 20px;
            transform: translateY(50%);
            animation: fading 2s infinite;
            text-transform: uppercase;
            font-size: 13px;
            font-family: 'Roboto Condensed', 'Roboto', sans-serif;
            font-weight: bold;
        }
    }

    @media all and (max-width: 650px) {
        .footer__nav-list {
            gap: 35px;
        }

        .footer__navigation {
            grid-template-columns: 1fr 1fr;
        }

        .footer__logo span {
            margin-left: 0;
            margin-top: 10px;
        }

        .footer__logo {
            flex-direction: column;
            align-items: flex-start;
        }

        .flex-wrap {
            gap: 20px;
        }

        .footer__sponsors img {
            width: 110px;
        }
    }
