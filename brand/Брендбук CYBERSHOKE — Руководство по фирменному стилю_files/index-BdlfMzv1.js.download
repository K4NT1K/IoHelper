`,G9=p.header`
    background: #11141c;
    white-space: nowrap;
    position: fixed;
    display: flex;
    align-items: center;
    gap: 24px;
    padding-left: 1vw;
    padding-right: 1vw;
    justify-content: space-between;
    left: var(--site-sidebar-width, 246px);
    right: 0;
    transition: all 0.2s ease;
    top: 0;
    height: 70px;
    z-index: 1200;
    box-shadow: none;

    @media all and (max-width: 1000px) {
        left: 0;
        gap: 12px;
        padding-left: 16px;
        padding-right: 16px;
    }

    img {
        vertical-align: middle;
    }

    .header-prem {
        height: 100%;
        display: flex;
        align-items: center;

        a {
            height: auto;
        }

        .premium-main-btn {
            margin-right: 10px;
        }
    }

    .premium-main-btn,
    .premium-main-btn span {
        font-weight: bold;
        font-size: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-transform: uppercase;
        color: #fdb510;
    }

    .premium-main-btn {
        padding: 0 14px;
        height: 32px;
        transition: all 0.3s ease;
        border: 1px solid #fdb510;
        box-sizing: border-box;
        border-radius: 5px;
        background: transparent;
    }

    button.icon-slide-left {
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    button.icon-slide-left::after {
        content: '';
        width: 15px;
        transform: translateY(-1px);
        height: 15px;
        display: block;
        background: url(${P("/img/general/crown.svg")}) no-repeat
            center center / cover;
        position: absolute;
        left: -20%;
        transition: 0.25s ease;
    }

    button.icon-slide-left span {
        transition: 0.25s ease;
    }

    button.icon-slide-left:hover span {
        margin-left: 20px;
    }

    button.icon-slide-left:hover:after {
        left: 10px;
    }

    .prolong span {
        text-transform: uppercase;
    }

    .login-btn-wrapper {
        height: 60px;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .login-btn {
        padding: 0 10px;
        height: 33px;
        background: #6080ff;
        border-radius: 6px;
        font-weight: bold;
        display: flex;
        font-family: 'Roboto';
        justify-content: center;
        align-items: center;
        font-size: 12px;
        white-space: nowrap;
        line-height: 14px;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.9);
        float: right;
    }

    .login-img {
        margin-left: 7px;
        width: 13px;
    }
`,V9=cs`
    body.static-header main {
        padding-top: 0;
    }

    body.static-header header {
        background: transparent;
        position: absolute;
    }

    body.dark-header header {
        background: #0f141b
            linear-gradient(
                to bottom,
                #030b12 0%,
                rgba(16, 21, 26, 0.5) 50%,
                rgba(20, 25, 30, 0) 80%
            );
    }

    @media (max-width: 1000px) {
        body.static-header main {
            padding-top: 70px;
        }
    }
