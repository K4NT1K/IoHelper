    .Toastify__toast-container {
        width: max-content;
        max-width: calc(100vw - 24px);
    }

    .Toastify__toast {
        border-radius: 8px;
        min-height: 47px;
        padding: 5px 20px 5px 56px;
    }

    .Toastify__toast-theme--warning {
        background:
            linear-gradient(0deg, rgba(109, 59, 13, 0.6), rgba(109, 59, 13, 0.6)),
            radial-gradient(
                103.8% 103.8% at 50% 0%,
                rgba(30, 35, 42, 0.95) 0%,
                rgba(18, 23, 31, 0.95) 100%
            );
        box-shadow: 0px 9px 74px rgba(0, 0, 0, 0.08);

        .Toastify__toast-body > div:last-child {
            color: #eba15d;

            &::before {
                background: url(${P("/img/modals/warn-alert.svg")}) no-repeat center center / contain;
            }
        }
    }

    .Toastify__toast-theme--error {
        background:
            linear-gradient(0deg, rgba(105, 48, 45, 0.6), rgba(105, 48, 45, 0.6)),
            radial-gradient(
                103.8% 103.8% at 50% 0%,
                rgba(30, 35, 42, 0.95) 0%,
                rgba(18, 23, 31, 0.95) 100%
            );
        box-shadow: 0px 9px 74px rgba(0, 0, 0, 0.08);

        .Toastify__toast-body > div:last-child {
            color: #eb645d;

            &::before {
                background: url(${P("/img/modals/fault.svg")}) no-repeat center center / contain;
            }
        }
    }

    .Toastify__toast-theme--success {
        background:
            linear-gradient(0deg, rgba(27, 37, 53, 0.6), rgba(27, 37, 53, 0.6)),
            radial-gradient(
                103.8% 103.8% at 50% 0%,
                rgba(30, 35, 42, 0.95) 0%,
                rgba(18, 23, 31, 0.95) 100%
            );
        box-shadow: 0px 9px 74px rgba(0, 0, 0, 0.08);

        .Toastify__toast-body > div:last-child {
            color: #dde4ff;

            &::before {
                background: url(${P("/img/modals/success-alert.svg")}) no-repeat center center / contain;
            }
        }
    }

    .Toastify__toast-body > div:last-child {
        font-weight: 500;
        font-size: 16px;

        &::before {
            content: '';
            position: absolute;
            display: block;
            top: 49%;
            transform: translateY(-50%);
            width: 14.4px;
            height: 14.4px;
            left: -31px;
        }
    }

    .Toastify__toast {
        width: fit-content;
        margin-left: auto;
        margin-right: auto;
        font-family: 'Roboto';
    }

    .Toastify__close-button {
        display: none;
    }
