    .servers-grid {
        grid-template-columns: repeat(auto-fill, minmax(18.5rem, 1fr));
        display: grid;
        gap: 0.8rem !important;
        height: 100% !important;
        overflow: initial;
        align-content: flex-start !important;
        padding-bottom: 20px;
    }

    .servers-grid > *,
    > .server-row {
        animation: ${ww} 0.22s ease both;
    }

    > .server-row {
        &::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 1600px;
            height: 100%;
            z-index: 1;
            pointer-events: none;
            transition: opacity 0.2s ease;
            background: linear-gradient(
                270deg,
                #171d29 84.7%,
                rgba(23, 29, 41, 0) 100%
            );
            opacity: 0;
        }

        &:hover {
            &::after {
                opacity: 1;
            }
        }
    }

    .category-wrapper > div {
        z-index: 1;
    }

    @media (prefers-reduced-motion: reduce) {
        .servers-grid > *,
        > .server-row {
            animation: none;
        }
    }
