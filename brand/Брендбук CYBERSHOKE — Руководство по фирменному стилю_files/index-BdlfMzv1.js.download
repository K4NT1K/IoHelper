`,ak=p.nav`
    position: relative;
    display: flex;
    height: 38px;
    align-items: center;
    gap: 4px;

    a {
        padding: 8px 16px;
        color: var(--landing-muted);
        font-size: 16px;
        font-weight: 500;
        line-height: 22px;
        transition: color 0.18s ease;

        &:hover,
        &:focus-visible {
            color: #f2f4ff;
        }

        &.is-active {
            color: var(--landing-accent);
        }
    }

    &::after {
        content: '';
        position: absolute;
        bottom: 1px;
        left: 0;
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: var(--landing-accent);
        opacity: var(--nav-dot-shown, 0);
        transform: translate3d(calc(var(--nav-dot-x, 0px) - 2px), 0, 0);
        transition:
            transform 0.46s cubic-bezier(0.22, 0.8, 0.24, 1),
            opacity 0.18s ease;
    }

    @media (max-width: 940px) {
        display: none;
    }
`,rl=p.a`
    display: inline-flex;
    box-sizing: border-box;
    width: 201px;
    height: 40px;
    flex: none;
    padding: 10px 16px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 6px;
    background: var(--landing-accent);
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
    white-space: nowrap;
    transition:
        background 0.22s ease,
        box-shadow 0.22s ease;

    svg {
        width: 16px;
        height: 16px;
        flex: none;
    }

    &:hover,
    &:focus-visible {
        background: #6e8bff;
        box-shadow: 0 8px 26px rgba(96, 128, 255, 0.3);
    }

    @media (max-width: 940px) {
        display: none;
    }
`,lk=p.button`
    position: relative;
    display: none;
    width: 38px;
    height: 38px;
    flex: none;
    margin-right: -2px;
    background: transparent;
    color: #fff;
    cursor: pointer;

    i {
        position: absolute;
        left: 8px;
        right: 8px;
        height: 2px;
        border-radius: 2px;
        background: currentColor;
        transition:
            transform 0.34s cubic-bezier(0.23, 1, 0.32, 1),
            opacity 0.16s ease;

        &:nth-child(1) {
            top: 14px;
            transform: ${({$open:e})=>e?"translateY(5px) rotate(45deg)":"none"};
        }

        &:nth-child(2) {
            top: 19px;
            opacity: ${({$open:e})=>e?0:1};
            transform: 'none';
        }

        &:nth-child(3) {
            top: 24px;
            transform: ${({$open:e})=>e?"translateY(-5px) rotate(-45deg)":"none"};
        }
    }

    @media (max-width: 940px) {
        display: block;
    }
