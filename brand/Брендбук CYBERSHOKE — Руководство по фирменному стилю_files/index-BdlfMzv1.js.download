`,_S=p(qt)`
    z-index: 3;
    grid-row: 1;
    grid-column: 1;
    align-self: start;

    @media (max-width: 900px) {
        align-self: auto;
    }
`,Xp=p.canvas`
    position: absolute;
    z-index: 1;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    cursor: crosshair;
    touch-action: pan-y;

    mask-image:
        linear-gradient(
            180deg,
            rgba(0, 0, 0, 0) 0%,
            rgba(0, 0, 0, 0.5) 8%,
            rgba(0, 0, 0, 1) 16%
        ),
        linear-gradient(
            90deg,
            rgba(0, 0, 0, 0) 0%,
            rgba(0, 0, 0, 0.5) 4.5%,
            rgba(0, 0, 0, 1) 9%,
            rgba(0, 0, 0, 1) 91%,
            rgba(0, 0, 0, 0.5) 95.5%,
            rgba(0, 0, 0, 0) 100%
        );
    mask-composite: intersect;

    @media (max-width: 900px) {
        position: relative;
        inset: auto;
        height: 420px;
    }

    @media (max-width: 640px) {
        height: 360px;
    }
`,ES=p.div`
    position: relative;
    grid-row: 1;
    grid-column: 1;
    width: 100%;
    height: clamp(620px, 63vw, 850px);
    overflow: hidden;

    &.is-dragging ${Xp} {
        cursor: grabbing;
    }

    @media (max-width: 900px) {
        grid-row: 2;
        display: flex;
        flex-direction: column;
        gap: 12px;
        height: auto;
        margin-top: clamp(24px, 3vw, 44px);
        overflow: visible;
    }

    @media (max-width: 640px) {
        margin-top: 18px;
    }
`,jS=p.div`
    position: absolute;
    z-index: 5;
    top: var(--location-y, 50%);
    left: var(--location-x, 50%);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    width: max-content;
    min-width: 168px;
    max-width: 240px;
    padding: 12px 16px;
    border-radius: 14px;
    background: linear-gradient(
        135deg,
        rgba(36, 46, 72, 0.72),
        rgba(17, 23, 38, 0.48)
    );
    box-shadow:
        inset 0 0 20px rgba(255, 255, 255, 0.045),
        0 20px 54px rgba(0, 0, 0, 0.26);
    backdrop-filter: blur(18px);
    opacity: 0;
    transform: translate(14px, -44%) scale(0.97);
    transform-origin: left center;
    transition:
        transform 0.22s cubic-bezier(0.2, 0.72, 0.12, 1),
        opacity 0.16s ease-out;
    pointer-events: none;

    &.is-visible {
        opacity: 1;
        transform: translate(14px, -50%) scale(1);
    }

    i {
        width: 28px;
        height: 28px;
        overflow: hidden;
        border-radius: 50%;
        box-shadow: inset 0 0 0 1px rgba(112, 140, 255, 0.28);

        img {
            display: block;
            width: 100%;
            height: 100%;
        }

        &:empty {
            display: none;
        }
    }

    span {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

    strong {
        overflow: hidden;
        color: #c8d2ec;
        font-size: 14px;
        font-weight: 600;
        line-height: 18px;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    small {
        display: flex;
        gap: 5px;
        align-items: flex-end;
        color: #9ca8bf;
        white-space: nowrap;

        svg {
            width: 18px;
            height: 18px;
            margin-bottom: 2px;
            fill: currentColor;
        }

        b {
            font-size: 24px;
            font-weight: 700;
            line-height: 24px;
            font-variant-numeric: tabular-nums;
            color: inherit;
        }
    }

    &.is-good small {
        color: #64b44d;
    }

    @media (max-width: 640px) {
        min-width: 148px;
        max-width: 208px;
        padding: 10px 13px;
        gap: 10px;

        i {
            width: 24px;
            height: 24px;
        }

        strong {
            font-size: 13px;
            line-height: 17px;
        }

        small {
            svg {
                width: 15px;
                height: 15px;
            }

            b {
                font-size: 20px;
                line-height: 20px;
            }
        }
    }
`,LS=p.div`
    position: absolute;
    z-index: 6;
    bottom: 108px;
    left: max(
        var(--landing-inset),
        calc((100% - var(--landing-container)) / 2)
    );
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 4px;
    width: 200px;
    height: var(--nf-panel-h);
    padding: 5px;

    ${Wp}

    &::before,
    &::after {
        content: '';
        position: absolute;
        z-index: 0;
        top: 0;
        right: 5px;
        left: 5px;
        height: var(--nf-marker-h, 0px);
        box-sizing: border-box;
        border-radius: 8px;
        opacity: var(--nf-marker-shown, 0);
        transform: translateY(var(--nf-marker-y, 0px));
        pointer-events: none;
        transition:
            transform 0.24s cubic-bezier(0.77, 0, 0.175, 1),
            height 0.24s cubic-bezier(0.77, 0, 0.175, 1),
            opacity 0.18s ease;
    }

    &::before {
        ${ma}
    }

    &::after {
        padding: 1px;
        background: linear-gradient(
            291deg,
            rgba(112, 140, 255, 0.38) 0%,
            rgba(112, 140, 255, 0.16) 35%,
            rgba(112, 140, 255, 0.03) 63%
        );
        mask:
            linear-gradient(#000 0 0) content-box,
            linear-gradient(#000 0 0);
        mask-composite: exclude;
    }

    button {
        position: relative;
        z-index: 1;
        min-height: 48px;
        padding: 0 14px;
        border: 0;
        border-radius: 8px;
        background: transparent;
        color: #b3bdd4;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        line-height: 17px;
        text-align: left;
        white-space: nowrap;
        cursor: pointer;
        transition:
            background 0.2s,
            color 0.2s,
            transform 0.2s;

        &:hover {
            color: #dbe2f3;
        }

        &:active {
            transform: scale(0.97);
        }

        &.is-active {
            color: #eef2ff;
        }
    }

    @media (max-width: 900px) {
        position: relative;
        bottom: auto;
        left: auto;
        order: 1;
        flex-direction: row;
        align-items: center;
        justify-content: flex-start;
        width: auto;
        height: auto;
        margin-inline: 16px;
        overflow-x: auto;
        scrollbar-width: none;

        &::-webkit-scrollbar {
            display: none;
        }

        &::before,
        &::after {
            display: none;
        }

        button.is-active {
            ${ma}
        }
    }

    @media (max-width: 640px) {
        margin-inline: 12px;

        button {
            min-height: 36px;
            padding-inline: 12px;
            font-size: 11px;
            text-align: center;
        }
    }
`,TS=p.aside`
    position: absolute;
    z-index: 5;
    right: max(
        var(--landing-inset),
        calc((100% - var(--landing-container)) / 2)
    );
    bottom: 108px;
    display: flex;
    flex-direction: column;
    width: 262px;
    max-height: var(--nf-panel-h);
    padding: 14px 8px 8px;

    ${Wp}

    > p {
        margin: 0 0 8px;
        padding-inline: 10px;
        color: #9ca8bf;
        font-family: 'Roboto', Arial, sans-serif;
        font-size: 13px;
        line-height: 1;
    }

    > div {
        display: grid;
        flex: 1;
        min-height: 0;
        grid-auto-rows: var(--nf-row-h);
        align-content: start;
        gap: 3px;
        overflow-y: auto;
        overscroll-behavior: contain;
        scrollbar-width: thin;
        scrollbar-color: rgba(112, 140, 255, 0.34) transparent;

        &::-webkit-scrollbar {
            width: 4px;
        }

        &::-webkit-scrollbar-track {
            background: transparent;
        }

        &::-webkit-scrollbar-thumb {
            border-radius: 2px;
            background: rgba(112, 140, 255, 0.34);
        }
    }

    @media (max-width: 900px) {
        position: relative;
        right: auto;
        bottom: auto;
        order: 2;
        width: auto;
        margin-inline: 16px;
    }

    @media (max-width: 640px) {
        --nf-row-h: 36px;

        margin-inline: 12px;
        padding: 10px 6px 6px;
        border-radius: 10px;

        > p {
            margin-bottom: 6px;
            padding-inline: 8px;
            font-size: 11px;
        }
    }
