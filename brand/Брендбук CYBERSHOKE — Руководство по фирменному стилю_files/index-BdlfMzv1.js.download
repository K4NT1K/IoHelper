    padding: 12px;

    & > * {
        padding: 12px 8px;
        display: flex;
        align-items: center;
        font-size: 14px !important;
        letter-spacing: 0.01em;
        font-weight: 400;
        font-size: 14px;
        color: #8499b9;
        transition: all 0.1s ease;

        &:hover {
            color: #c7d3e2;

            path,
            .fill {
                fill: #c7d3e2;
            }

            .stroke {
                stroke: #c7d3e2;
            }
        }
    }

    path,
    rect {
        transition: all 0.1s ease;
    }
`,jn=p.div`
    width: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
`,j1=p.span`
    background: #273047;
    height: 2px;
    width: 100%;
    border-radius: 11px;
    margin: 6px 0;
    display: block;
    padding: 0;
`,p9=p.div`
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 999;

    &.mobile__menu-enter {
        opacity: 0;
        transform: translateY(20px);
    }

    &.mobile__menu-enter-active {
        opacity: 1;
        transform: translateY(0);
        transition: all 0.3s ease;
    }

    &.mobile__menu-enter-done {
        opacity: 1;
        transform: translateY(0);
    }

    &.mobile__menu-exit-active {
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.3s ease;
    }

    &.mobile__menu-exit-done {
        opacity: 0;
    }
`,E2=p.div`
    cursor: pointer;

    & > div:first-child {
        display: flex;
        align-items: center;
    }
`,u9=p.div`
    width: 35px;
    height: 35px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #1b2229;
    border: ${({$premium:e})=>e==="LITE"?"2px solid #6080ff":e!=="none"?"2px solid #fdb510":"none"};
    border-radius: 50%;
    cursor: pointer;
    overflow: hidden;

    img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
    }
`,f9=p.div`
    margin-left: 16px;

    img {
        transition: 0.3s;
        width: 12px;
        opacity: 0.5;
        cursor: pointer;
        transform: rotate(180deg);
    }

    img.active {
        transform: rotate(0deg);
    }

    ${E2}:hover & img {
        opacity: 1;
    }
`,g9=p.div`
    background: #273047;
    height: auto;
`,h9=p(_e)`
    padding: 18px 24px;
    height: auto;
    font-family: 'Roboto';
    width: 100%;
    display: flex;
    align-items: center;
    border-radius: 8px;
    transition: all 0.3s ease;

    & > div {
        display: flex;
        flex-direction: column;
        max-width: 130px;
    }

    &:hover span:first-of-type {
        color: #fff;
    }

    &:hover span:last-child {
        color: #c7d3e2;
    }
`,m9=p.img`
    width: 32px;
    height: 32px;
    border-radius: 50%;
    margin-right: 10px;
`,x9=p.span`
    font-weight: 500;
    font-size: 14px;
    letter-spacing: 0.01em;
    color: #c7d3e2;
    margin-bottom: 3px;
    transition: color 0.2s ease;
    text-overflow: ellipsis;
    overflow: hidden;
    max-width: 100%;
`,b9=p.span`
    font-size: 12px;
    font-weight: normal;
    letter-spacing: 0.01em;
    color: #8499b9;
    transition: all 0.3s ease;
`,_r=p(_e)`
    display: flex;
    align-items: center;
    border-radius: 8px;

    &:hover {
        background: #273047;
    }
`,y9=p.a`
    display: flex;
    align-items: center;
    border-radius: 8px;

    &:hover {
        background: #273047;
    }
`,v9=p(_r)`
    img {
        height: 16px;
        top: -1px;
    }
`,w9=p.div`
    position: absolute;
    top: 100%;
    overflow: hidden;
    right: -15px;
    width: 256px;
