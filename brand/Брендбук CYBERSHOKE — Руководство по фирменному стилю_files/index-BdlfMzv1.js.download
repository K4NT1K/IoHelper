    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 368px;
    max-width: calc(100vw - 32px);
    padding: 10px;
    border-radius: 12px;
    background: #22263c;
    box-shadow: 0 8px 12px 0 rgba(8, 11, 17, 0.3);
`,ly=p.div`
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 6px;
    background: rgba(93, 108, 146, 0.16);
`,cy=p.div`
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;

    img {
        width: 20px;
        height: 20px;
        flex: 0 0 auto;
        opacity: 0.4;
    }

    p {
        color: #9fb1c9;
        font-size: 14px;
        font-weight: 500;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
`,dy=p.div`
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    gap: 6px;
`,yp=p.div`
    position: relative;
    width: 100%;
    height: 140px;
    border-radius: 6px;
    background: rgba(15, 22, 36, 0.74);
    overflow: hidden;

    &::after {
        content: '';
        position: absolute;
        inset: 0;
        background:
            linear-gradient(
                0deg,
                rgba(33, 40, 60, 0.4) 0%,
                rgba(33, 40, 60, 0.4) 100%
            ),
            linear-gradient(
                180deg,
                rgba(0, 0, 0, 0) 0%,
                rgba(0, 0, 0, 0.2) 100%
            );
        pointer-events: none;
    }

    img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
    }
`,py=`
    linear-gradient(
        170deg,
        rgba(8, 11, 17, 0) 56.02%,
        rgba(8, 11, 17, 0.9) 128.89%
    ),
    linear-gradient(
        180deg,
        rgba(62, 79, 168, 0) 38.75%,
        rgba(96, 128, 255, 0.9) 100%
    ),
    linear-gradient(
        187deg,
        rgba(8, 11, 17, 0) -15.32%,
        rgba(8, 11, 17, 0.9) 113.92%
    )
`,uy=p.button`
    position: relative;
    min-width: 0;
    border-radius: 6px;
    background: rgba(93, 108, 146, 0.1);
    color: #9fb1c9;
    transition: all 0.2s ease;
    overflow: hidden;

    .tick {
        z-index: 1;
        position: absolute;
        right: 0;
        top: 0;
        width: 20px;
        height: 20px;
        border-radius: 4px;
        background: #6080ff;
        display: none;
        align-items: center;
        justify-content: center;
    }

    &:hover {
        background: rgba(93, 108, 146, 0.18);
        color: #d3ddeb;
    }

    &.active {
        box-shadow: none;

        ${yp}::after {
            background: ${py};
        }

        .tick {
            display: flex;
        }
    }

    &.active::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 2;
        border-radius: 6px;
        box-shadow: inset 0 0 0 2px #6080ff;
        pointer-events: none;
    }

    &.disabled {
        pointer-events: none;
        opacity: 0.65;
        filter: none;
    }
`,fy=p.div`
    padding: 4px 7px;
    display: flex;
    align-items: center;
    gap: 5px;
    position: absolute;
    left: 6px;
    bottom: 6px;
    border-radius: 3px;
    background: rgba(33, 40, 60, 0.7);

    p {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 12px;
        font-weight: 500;
    }

    &.premium {
        background: #ffc860;

        p {
            color: #13131b;
        }
    }
