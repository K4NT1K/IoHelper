    border: 2px solid #6080ff;
    border-radius: 12px;
    background: #131b2e
        url(${P("/pages/servers/auth-banner-bg.png")}) no-repeat
        center center / cover;
    padding: 24px 16px 24px 16px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    overflow: hidden;

    .slider-container {
        width: 261px;
    }

    .slick-slider,
    .slick-list {
        width: 100%;
        overflow: visible;
    }

    .slick-list {
        top: 14px;
        left: 92px;
    }

    .slick-slide:not(:last-of-type) {
        padding-right: 8px;
    }

    .slick-slide {
        opacity: 0.5;
        transition:
            opacity 0.5s ease,
            transform 0.5s ease;

        &.slick-current {
            opacity: 1;
            transform: translateY(-23px);
        }
    }

    .slick-slide {
        height: auto;
    }

    .slick-arrow {
        display: none !important;
    }

    h3 {
        color: #c5d5ff;
        text-align: center;
        font-size: 14px;
        font-weight: 500;
        line-height: 130%;
        text-transform: none;
    }

    button {
        border-radius: 8px;
        background: #6080ff;
        padding: 12px;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #fff;
        font-size: 11px;
        font-weight: 700;

        img {
            width: 15px;
        }
    }
`,ZC=p(VC)`
    display: flex;
    align-items: center;
    gap: 7px;
`,YC=p.div`
    border-radius: 19px;
    background: linear-gradient(162deg, #31469b 0.77%, #6080ff 82.23%);
    backdrop-filter: blur(2px);
    width: 67px;
    height: 106px;
    overflow: hidden;

    div {
        width: 100%;
        height: 100%;
        mask-image: linear-gradient(
            172deg,
            #d9d9d9 42.7%,
            rgba(217, 217, 217, 0) 94.96%
        );
    }

    img {
        position: absolute;
        width: 130%;
        top: 25px;
        left: 50%;
        transform: translateX(-50%);
    }

    &:nth-child(2) {
        opacity: 1;
        top: -14px;
    }
`,KC=p.span`
    border-radius: 105px;
    background: #1a213d;
    backdrop-filter: blur(6.434042930603027px);
    position: absolute;
    width: calc(100% - 10px);
    left: 5px;
    bottom: 5px;
    z-index: 1;
    text-align: center;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    padding: 8px 0;
