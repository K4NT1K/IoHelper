        width: 21px;
        height: 21px;
        display: flex;
        align-items: center;
        margin-left: 16px;
        margin-right: 11px;
        justify-content: center;

        &::after {
            content: '';
            width: 6px;
            height: 6px;
            background: #33ff7b;
            border: 1px solid rgba(33, 41, 61, 0.4);
            box-sizing: border-box;
            display: block;
            border-radius: 50%;
            position: absolute;
            left: -1px;
            top: 1px;
