    position: absolute;
    z-index: 20;
    top: calc(100% + 10px);
    left: ${({$alignLeft:e})=>e?0:"50%"};
    width: ${({$singleColumn:e})=>e?"266px":"510px"};
    max-width: calc(100vw - 24px);
    max-height: 364px;
    overflow-x: hidden;
    overflow-y: auto;
    border-radius: 8px;
    background: #22263c;
    box-shadow: 0 16px 24px rgba(8, 11, 17, 0.3);
    transform: ${({$alignLeft:e})=>e?"none":"translateX(-50%)"};

    &.filter-popup-enter {
        opacity: 0;
    }

    &.filter-popup-enter-active,
    &.filter-popup-enter-done {
        opacity: 1;
    }

    &.filter-popup-enter-active,
    &.filter-popup-exit-active {
        transition: opacity 0.2s ease;
    }

    &.filter-popup-exit-active {
        opacity: 0;
    }

    &::-webkit-scrollbar {
        width: 7px;
    }

    &::-webkit-scrollbar-track {
        background: transparent;
    }

    &::-webkit-scrollbar-thumb {
        border: 1px solid #282933;
        border-radius: 99px;
        background: #10111c;
    }
`,Xy=p.div`
    height: 56px;
    padding: 6px;
    border-bottom: 2px solid rgba(53, 63, 85, 0.24);
    background: #22263c;
`,Zy=p.button`
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    height: 44px;
    padding: 0 12px;
    border-radius: 6px;
    background: transparent;
    color: #9fb1c9;
    font-size: 14px;
    font-weight: 700;
    text-align: left;

    &:hover {
        background: #2c314a;
    }
`,Yy=p.span`
    width: 18px;
    height: 18px;
    flex-shrink: 0;

    img {
        position: absolute;
        display: block;

        &:first-child {
            top: 0.18px;
            left: 2.25px;
            width: 15.56px;
            height: 15.56px;
        }

        &:last-child {
            top: 4.69px;
            left: 0;
            width: 13.31px;
            height: 13.31px;
        }
    }
`,Ky=p.div`
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 6px;
`,qy=p.div`
    display: flex;
    align-items: center;

    button {
        position: absolute;
        right: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 100%;
        background: transparent;

        path {
            transition: fill 0.2s ease;
        }

        &:hover path {
            fill: #9fb1c9;
        }
    }
`,Jy=p.input`
    width: 100%;
    height: 44px;
    padding: 0 40px 0 10px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.02);
    color: #9fb1c9;
    font-size: 14px;

    &::placeholder {
        color: #778597;
    }
`,ev=p.div`
    display: grid;
    grid-template-columns: ${({$singleColumn:e})=>e?"1fr":"repeat(2, minmax(0, 1fr))"};

    @media (max-width: 650px) {
        grid-template-columns: 1fr;
    }
`,tv=p.button`
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-width: 0;
    height: 44px;
    padding: 10px 12px;
    border-radius: 6px;
    background: transparent;
    opacity: ${({$muted:e})=>e?.5:1};
    text-align: left;

    &:hover {
        background: #2c314a;
    }
`,nv=p.span`
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    flex: 1;
`,rv=p.img`
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    border-radius: ${({$isIconRounded:e})=>e?"4px":"0"};
    object-fit: cover;
`,iv=p.span`
    min-width: 0;
    overflow: hidden;
    color: #9ba7c2;
    font-size: 14px;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
`,sv=p.img`
    width: 14px;
    height: 14px;
    flex-shrink: 0;
`,pc=p.span`
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    margin-left: auto;
    flex-shrink: 0;
    border: 2px solid rgba(119, 129, 149, 0.3);
    border-radius: 6px;
    background: ${({$active:e})=>e?"#6080ff":"transparent"};

    img {
        width: 14px;
        height: 14px;
        filter: brightness(0.1);
        opacity: ${({$active:e})=>e?1:0};
    }
`,ov=p.div`
    .arrow {
        transition: transform 0.2s ease;
    }

    &.active .arrow {
