                position: absolute;
                right: 0;
                bottom: 0;
                top: auto;
                left: auto;
            }
        }
    }

    &.bubble__3 {
        div {
            width: 23px;
            height: 23px;

            &:nth-child(2) {
                position: absolute;
                right: 0;
                top: 6px;
                left: auto;
                bottom: auto;
            }

            &:nth-child(3) {
                position: absolute;
                bottom: 0;
                left: 7px;
                top: auto;
                right: auto;
            }
        }
    }
