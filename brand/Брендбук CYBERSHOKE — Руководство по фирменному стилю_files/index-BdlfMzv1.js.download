`,Xj=p.div`
    display: flex;
    flex-wrap: wrap;
    gap: 6px;

    button {
        font-family: monospace;
        font-size: 12px;
        font-weight: 500;
    }

    button.active {
        color: #ffffff;
        background: rgba(96, 128, 255, 0.35);
