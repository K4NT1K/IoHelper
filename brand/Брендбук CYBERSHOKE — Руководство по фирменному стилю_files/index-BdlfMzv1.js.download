    aspect-ratio: 250 / 328;
    flex-direction: column;
    z-index: 0;
    overflow: hidden;
    border-radius: 16px;
    box-shadow: 0 20px 70px rgba(6, 10, 26, 0.4);
    transition: scale 0.22s cubic-bezier(0.2, 0.6, 0.35, 1);

    &.csgo, &.rust {
        scale: 0.97;
