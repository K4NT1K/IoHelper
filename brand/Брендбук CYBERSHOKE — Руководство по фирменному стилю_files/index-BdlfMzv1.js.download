    &.type-1 {
        padding: 12px 16px;
        background: #252c3f;
        box-shadow: 0px 11px 18px rgba(15, 20, 27, 0.25);
        border-radius: 6px;
        top: calc(100% + 10px);

        li {
            font-weight: 400;
            font-size: 14px;
            line-height: 31px;
            color: #a3acc0;
            text-overflow: ellipsis;
            overflow: hidden;
            white-space: nowrap;
            max-width: 100%;

            &.active {
                color: #6080ff;
            }
        }
    }

    &.type-2 {
        background: #1f2637;
        top: calc(100% + 10px);
        padding: 12px 16px;
        display: flex;
        flex-direction: column;
        gap: 5px;
        width: 100%;

        div {
            color: #7a8697;
            cursor: pointer;
            transition: color 0.2s ease;

            &:hover {
                color: #fff;
            }
        }
    }

    &.type-3 {
        border-radius: 8px;
        background: #22263c;
        box-shadow: 0px 16px 24px 0px rgba(8, 11, 17, 0.3);
        padding: 6px;
        left: 50%;
        transform: translateX(-50%);
        width: 250px;
        top: calc(100% + 10px);

        li {
            display: flex;
            align-items: center;
            padding: 10px 12px;
            border-radius: 6px;
            color: #9fb1c9;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.3s ease;
            cursor: pointer;

            &:hover {
                background: #2c314a;
                color: #d3ddeb;
            }

            img {
                width: 15px;
                margin-right: 10px;
            }
        }
    }
